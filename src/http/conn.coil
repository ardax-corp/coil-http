// `Conn`, the connection HTTP runs over (a TCP `Stream` or a TLS
// `TlsStream`), and per-connection HTTP/1.1 framed reads (headers +
// Content-Length body).
use io::{Stream, IoError, Read, Write, Close};
use io::sync::{read_exact};
use tls::stream::{TlsStream};
use http::url::{HttpError, http_err_protocol, http_err_io, http_fail_unit};
use http::request::{concat_bytes};
use http::response::{bytes_slice_resp, find_header_end, header_block_body_len, parse_chunk_size_line};

/// A connection HTTP runs over: a plain TCP `Stream` or a `TlsStream`.
///
/// It reads, writes and closes as `io::Read`, `io::Write` and `io::Close`, so
/// `io::sync::write_all` and the buffered reader take it, and `protocol` names
/// the ALPN protocol a TLS handshake agreed on.
///
/// # Examples
///
/// ```no_run
/// use io::net::tcp::{connect};
/// use io::sync::{write_all};
/// use string::{to_bytes};
/// use http::conn::{Conn};
///
/// fn main() {
///     let tcp = match connect("127.0.0.1", 8080) {
///         Result::Ok(s) => s,
///         Result::Err(e) => panic e.show(),
///     };
///     let c: Conn = tcp;
///     // Plain TCP agrees on no ALPN protocol: `c.protocol()` is `""`.
///     let _ = write_all(c, to_bytes("GET / HTTP/1.1\r\nHost: x\r\n\r\n"));
///     let _ = c.close();
/// }
/// ```
trait Conn<S: Read + Write + Close> {
    /// The ALPN protocol the peers agreed on (`"h2"`), or `""` for none and
    /// for plain TCP.
    fn protocol(S s) -> string;
}

impl Conn for Stream {
    fn protocol(Stream s) -> string {
        return "";
    }
}

impl Conn for TlsStream {
    fn protocol(TlsStream s) -> string {
        return match s.alpn() {
            Result::Ok(p) => p,
            Result::Err(_) => "",
        };
    }
}

impl Read for Conn {
    fn read(Conn c, Vec<byte> buf) -> Result<Option<int>, IoError> {
        return c.read(buf);
    }

    fn wait_readable(Conn c) -> Result<unit, IoError> {
        return c.wait_readable();
    }
}

impl Write for Conn {
    fn write(Conn c, readonly Vec<byte> buf) -> Result<int, IoError> {
        return c.write(buf);
    }

    fn wait_writable(Conn c) -> Result<unit, IoError> {
        return c.wait_writable();
    }

    fn write_from(Conn c, readonly Vec<byte> buf, int offset) -> Result<int, IoError> {
        return c.write_from(buf, offset);
    }

    fn flush(Conn c) -> Result<unit, IoError> {
        return c.flush();
    }
}

impl Close for Conn {
    fn close(Conn c) -> Result<unit, IoError> {
        return c.close();
    }
}

/// A connection plus the bytes read past the current HTTP/1.1 message.
///
/// `read_http_message` keeps any bytes after one message (a pipelined request or
/// the next response) in `leftover` for the next read, so a keep-alive
/// connection is read message by message. Used by `ConnPool`, the server loops
/// and `WsConn`. Close it with `close_conn`.
class HttpConn {
    /// The underlying TCP or TLS connection.
    pub inner: Conn,
    /// Bytes already read that belong to the next message.
    pub leftover: Vec<byte>,
    /// 1 when the last message was framed and the connection can carry another.
    pub reusable: int,
    /// 1 once `close_conn` closed the stream.
    pub closed: int,
}

/// Closes `c`'s stream. Closing twice does nothing; close errors are ignored.
fn close_conn(HttpConn c) {
    if c.closed == 1 {
        return;
    }
    c.closed = 1;
    match c.inner.close() {
        Result::Ok(_) => 0,
        Result::Err(_) => 0,
    };
}

impl HttpConn {
    /// Wraps an open connection with no buffered bytes.
    pub static fn wrap(Conn s) -> HttpConn {
        let leftover: Vec<byte> = Vec::new();
        return new HttpConn(s, leftover, 1, 0);
    }

    /// The underlying connection, for writing.
    pub fn stream() -> Conn {
        return self.inner;
    }

    /// 1 when the connection can carry another message, otherwise 0.
    pub fn can_reuse() -> int {
        return self.reusable;
    }

    fn drop() {
        if self.closed == 0 {
            self.closed = 1;
            match self.inner.close() {
                Result::Ok(_) => 0,
                Result::Err(_) => 0,
            };
        }
        self.closed = self.closed;
    }
}

fn make_chunk() -> Vec<byte> {
    let z: byte = 0;
    let chunk: Vec<byte> = Vec::new();
    let i = 0;
    while i < 64 {
        chunk.push(z);
        i = i + 1;
    }
    return chunk;
}

fn leftover_take(HttpConn c, int n) -> Vec<byte> {
    let have = c.leftover.len();
    let take = n;
    if take > have {
        take = have;
    }
    let out = bytes_slice_resp(c.leftover, 0, take);
    if take < have {
        c.leftover = bytes_slice_resp(c.leftover, take, have);
    } else {
        let empty: Vec<byte> = Vec::new();
        c.leftover = empty;
    }
    return out;
}

fn read_n(HttpConn c, int n) -> Result<Vec<byte>, HttpError> {
    let out = leftover_take(c, n);
    let need = n - out.len();
    if need == 0 {
        return out;
    }
    let buf: Vec<byte> = Vec::new();
    let k = 0;
    while k < need {
        buf.push(0);
        k = k + 1;
    }
    let got = match read_exact(c.inner, buf) {
        Result::Ok(o) => o,
        Result::Err(e) => {
            http_err_io(e)?;
            Option::None
        },
    };
    match got {
        Option::None => {
            http_err_protocol()?;
        },
        Option::Some(m) => {
            if m < need {
                http_err_protocol()?;
            }
            let j = 0;
            while j < need {
                out.push(buf[j]);
                j = j + 1;
            }
        },
    };
    return out;
}

fn read_crlf_line(HttpConn c) -> Result<Vec<byte>, HttpError> {
    let acc: Vec<byte> = Vec::new();
    let guard = 0;
    let cr: byte = "\r";
    let lf: byte = "\n";
    while guard < 4096 {
        let b = read_n(c, 1)?;
        if acc.len() > 0 {
            if acc[acc.len() - 1] == cr {
                if b[0] == lf {
                    return bytes_slice_resp(acc, 0, acc.len() - 1);
                }
            }
        }
        acc.push(b[0]);
        guard = guard + 1;
    }
    http_err_protocol()?;
    return acc;
}

fn read_chunked_wire(HttpConn c) -> Result<Vec<byte>, HttpError> {
    let acc: Vec<byte> = Vec::new();
    let cr: byte = "\r";
    let lf: byte = "\n";
    let keep = 1;
    while keep == 1 {
        let line = read_crlf_line(c)?;
        let i = 0;
        while i < line.len() {
            acc.push(line[i]);
            i = i + 1;
        }
        acc.push(cr);
        acc.push(lf);
        let size = parse_chunk_size_line(line)?;
        if size == 0 {
            let trail = 1;
            while trail == 1 {
                let t = read_crlf_line(c)?;
                let j = 0;
                while j < t.len() {
                    acc.push(t[j]);
                    j = j + 1;
                }
                acc.push(cr);
                acc.push(lf);
                if t.len() == 0 {
                    trail = 0;
                }
            }
            keep = 0;
        } else {
            let data = read_n(c, size)?;
            let k = 0;
            while k < data.len() {
                acc.push(data[k]);
                k = k + 1;
            }
            let nl = read_n(c, 2)?;
            if nl.len() < 2 {
                http_err_protocol()?;
            }
            if nl[0] != cr {
                http_err_protocol()?;
            }
            if nl[1] != lf {
                http_err_protocol()?;
            }
            acc.push(cr);
            acc.push(lf);
        }
    }
    return acc;
}

fn append_read(Vec<byte> acc, Vec<byte> chunk, int nread) {
    let j = 0;
    while j < nread {
        acc.push(chunk[j]);
        j = j + 1;
    }
}

/// Reads one complete HTTP/1.1 message (head and body) from `c`.
///
/// The body is framed by `Content-Length` or chunked encoding (returned still
/// chunked); a message with neither ends at the head. Bytes after the message
/// stay on `c`. Waits while the socket has no data. Returns `Protocol` when the
/// peer closes before the head is complete and `Io` when the socket fails.
fn read_http_message(HttpConn c) -> Result<Vec<byte>, HttpError> {
    let acc = leftover_take(c, c.leftover.len());
    let chunk = make_chunk();
    let guard = 0;
    let done = 0;
    while done == 0 {
        if guard >= 256 {
            done = 1;
        }
        if done == 0 {
            let end = find_header_end(acc);
            if end != 999999 {
                done = 1;
            }
        }
        if done == 0 {
            let parked = 0;
            let nopt = match c.inner.read(chunk) {
                Result::Ok(o) => o,
                Result::Err(IoError::WouldBlock) => {
                    match c.inner.wait_readable() {
                        Result::Ok(_) => {
                            parked = 1;
                            guard = guard - 1;
                            Option::None
                        },
                        Result::Err(e) => {
                            http_err_io(e)?;
                            Option::None
                        },
                    }
                },
                Result::Err(_) => Option::None,
            };
            if parked == 0 {
                let nread = 0;
                let got = 0;
                match nopt {
                    Option::None => {
                        if acc.len() > 0 {
                            done = 1;
                        }
                    },
                    Option::Some(n) => {
                        nread = n;
                        got = 1;
                    },
                };
                if got == 1 {
                    if nread == 0 {
                        if acc.len() > 0 {
                            done = 1;
                        } else {
                            match c.inner.wait_readable() {
                                Result::Ok(_) => {
                                    guard = guard - 1;
                                    0
                                },
                                Result::Err(e) => {
                                    http_err_io(e)?;
                                    0
                                },
                            };
                        }
                    } else {
                        append_read(acc, chunk, nread);
                    }
                }
            }
        }
        guard = guard + 1;
    }
    let sep = find_header_end(acc);
    if sep == 999999 {
        http_err_protocol()?;
    }
    let head = bytes_slice_resp(acc, 0, sep + 4);
    let extra = bytes_slice_resp(acc, sep + 4, acc.len());
    c.leftover = extra;
    let header_bytes = bytes_slice_resp(acc, 0, sep);
    let body_len = header_block_body_len(header_bytes)?;
    if body_len == 999998 {
        let wire = read_chunked_wire(c)?;
        c.reusable = 1;
        return concat_bytes(head, wire);
    }
    if body_len == 999999 {
        return head;
    }
    let body = read_n(c, body_len)?;
    c.reusable = 1;
    return concat_bytes(head, body);
}

/// Reads one complete HTTP/1.1 message from a fresh connection `s`.
fn read_request_bytes(Conn s) -> Result<Vec<byte>, HttpError> {
    let c = HttpConn::wrap(s);
    return read_http_message(c)?;
}
